# ===========================================
# Waterflow Docker Compose 环境变量配置
# ===========================================
# 使用方法:
# 1. 复制此文件: cp .env.example .env
# 2. 修改配置项 (大部分使用默认值即可)
# 3. 启动服务: docker compose up -d
# 
# 注意: .env 文件已在 .gitignore 中,不会提交到版本控制
# ===========================================

# -----------------------------
# PostgreSQL 配置
# -----------------------------
POSTGRESQL_VERSION=16
# PostgreSQL 镜像版本

POSTGRES_USER=temporal
# 数据库用户名

POSTGRES_PASSWORD=temporal
# 数据库密码 (生产环境请修改为强密码)

POSTGRES_DB=temporal
# 数据库名称

# -----------------------------
# Temporal 配置
# -----------------------------
TEMPORAL_VERSION=1.29.2
# Temporal 镜像版本

TEMPORAL_ADMINTOOLS_VERSION=1.29.1-tctl-1.18.4-cli-1.5.0
# Temporal Admin Tools 镜像版本

TEMPORAL_UI_VERSION=2.44.0
# Temporal UI 镜像版本

TEMPORAL_LOG_LEVEL=info
# 日志级别: debug, info, warn, error

# -----------------------------
# Waterflow Server 配置
# -----------------------------
WATERFLOW_SERVER_HOST=0.0.0.0
# Server 监听地址 (0.0.0.0 表示所有接口)

WATERFLOW_SERVER_PORT=8080
# API 服务端口 (对外暴露)

WATERFLOW_TEMPORAL_HOST=temporal:7233
# Temporal 连接地址 (内部网络地址,不要修改)

WATERFLOW_TEMPORAL_NAMESPACE=default
# Temporal 命名空间

WATERFLOW_TEMPORAL_TASKQUEUE=waterflow-server
# Temporal Task Queue 名称

WATERFLOW_LOG_LEVEL=info
# 日志级别: debug, info, warn, error

WATERFLOW_LOG_FORMAT=json
# 日志格式: json, text

# WATERFLOW_SERVER_API_KEY=
# API 认证密钥 (可选,留空则不启用认证)
# 生产环境建议设置强密钥

# -----------------------------
# Agent 配置
# -----------------------------
AGENT_LOG_LEVEL=info
# Agent 日志级别: debug, info, warn, error

AGENT_TASK_QUEUES=linux-amd64,linux-common
# Agent 监听的 Task Queue 列表 (逗号分隔)
# 必须与工作流 YAML 中的 runs-on 匹配

# -----------------------------
# Temporal UI 配置
# -----------------------------
TEMPORAL_UI_PORT=8088
# Temporal UI Web 端口映射 (容器内监听 8080,映射到宿主机 8088)
# 可选,仅用于开发调试

TEMPORAL_UI_CORS_ORIGINS=http://localhost:8088
# CORS 允许的来源 (开发环境)

# -----------------------------
# 高级配置 (通常不需要修改)
# -----------------------------
# COMPOSE_PROJECT_NAME=waterflow
# Docker Compose 项目名称 (影响容器和网络命名)

WATERFLOW_SERVER_IMAGE_TAG=latest
# Waterflow Server 镜像标签

WATERFLOW_AGENT_IMAGE_TAG=latest
# Waterflow Agent 镜像标签

# WATERFLOW_SERVER_READ_TIMEOUT=30s
# HTTP 读取超时

# WATERFLOW_SERVER_WRITE_TIMEOUT=30s
# HTTP 写入超时
